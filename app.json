{
  "expo": {
    "name": "DieTai Ai",
    "slug": "ai-agent-client",
    "scheme": "ai-agent-client-toto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.yourname.toto",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon-1024-padded.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-audio",
      "expo-system-ui",
      "react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
