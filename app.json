{
  "expo": {
    "name": "DieTai Ai",
    "slug": "ai-agent-client",
    "scheme": "ai-agent-client-toto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "sdkVersion",
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "提问天气时用于获取你当前所在的城市，提供当地天气"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.dietai.agent",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon-1024-padded.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/logo-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-audio",
      "expo-location",
      "expo-system-ui",
      "react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "./plugins/withAbiSplits.js",
      "./plugins/withHighRefreshRate.js",
      "./plugins/withResourceShrink.js",
      "./plugins/withLintDisable.js",
      "./plugins/withWindowBackground.js",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# --- 项目自定义 keep(JNI/反射敏感类,防止 R8 混淆后运行时崩溃) ---\n# react-native-pdf:JNI 直呼类名,不能混淆\n-keep class org.wonday.pdf.** { *; }\n-keep class com.shockwave.pdfium.** { *; }\n# react-native-blob-util:文件下载/预览用\n-keep class com.RNFetchBlob.** { *; }\n"
          }
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "57c842b8-e90e-44fb-8118-bc85a3c4dca5"
      }
    },
    "owner": "553807266",
    "updates": {
      "url": "https://u.expo.dev/57c842b8-e90e-44fb-8118-bc85a3c4dca5",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
